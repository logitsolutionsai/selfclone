{
  "name": "selfclone",
  "version": "0.1.0",
  "description": "Clone yourself. It writes like you, thinks like you, has your face, and proves how close it gets.",
  "type": "module",
  "bin": {
    "selfclone": "scripts/selfclone.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "scripts/",
    "src/",
    "face/",
    "templates/",
    "SKILL.md",
    ".claude-plugin/",
    "README.md",
    "ETHICS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=4 \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=600000 \"tests/e2e/*.test.mjs\"",
    "gif": "node docs/make-media.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "keywords": [
    "agent-skill",
    "claude-code",
    "persona",
    "stylometry",
    "burrows-delta",
    "avatar",
    "lip-sync",
    "privacy-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/logitsolutionsai/selfclone.git"
  },
  "homepage": "https://github.com/logitsolutionsai/selfclone",
  "license": "MIT",
  "author": "Logit Solutions AI"
}
