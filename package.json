{
  "name": "selfclone",
  "version": "0.1.0",
  "description": "Clone how you write from your own chat exports, give the clone a talking face, and score it on your real messages. A Claude Code skill (agent skill) for Claude Code, Codex and Cursor.",
  "type": "module",
  "bin": {
    "selfclone": "scripts/selfclone.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "scripts/",
    "src/",
    "face/",
    "templates/",
    "SKILL.md",
    ".claude-plugin/",
    "README.md",
    "ETHICS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=4 \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=600000 \"tests/e2e/*.test.mjs\"",
    "gif": "node tools/make-media.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "keywords": [
    "claude-code",
    "claude-skill",
    "claude-code-skill",
    "agent-skills",
    "agent-skill",
    "codex",
    "cursor",
    "ai-clone",
    "digital-twin",
    "persona",
    "writing-style",
    "stylometry",
    "burrows-delta",
    "voice-check",
    "talking-avatar",
    "lip-sync",
    "privacy-first",
    "offline-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/logitsolutionsai/selfclone.git"
  },
  "homepage": "https://github.com/logitsolutionsai/selfclone",
  "license": "MIT",
  "author": "Logit Solutions AI"
}
