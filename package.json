{
  "name": "selfclone",
  "version": "0.2.0",
  "description": "Animated explainer videos on any topic, made by Claude Code on your own computer: your drawn character, random fictional people or no host, with lip-synced voices, props, charts and Manim maths. Plus a writing clone of you, scored on your real messages. A Claude Code skill (agent skill) for Claude Code, Codex and Cursor.",
  "type": "module",
  "bin": {
    "selfclone": "scripts/selfclone.mjs"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "scripts/",
    "src/",
    "face/",
    "schemas/",
    "templates/",
    "SKILL.md",
    ".claude-plugin/",
    "README.md",
    "ETHICS.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=4 \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=600000 \"tests/e2e/*.test.mjs\"",
    "gif": "node tools/make-media.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "keywords": [
    "claude-code",
    "claude-skill",
    "claude-code-skill",
    "agent-skills",
    "agent-skill",
    "codex",
    "cursor",
    "explainer-video",
    "animation",
    "text-to-speech",
    "kokoro",
    "manim",
    "video-generation",
    "education",
    "ai-clone",
    "digital-twin",
    "persona",
    "writing-style",
    "stylometry",
    "burrows-delta",
    "voice-check",
    "talking-avatar",
    "lip-sync",
    "privacy-first",
    "offline-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/logitsolutionsai/selfclone.git"
  },
  "homepage": "https://github.com/logitsolutionsai/selfclone",
  "license": "MIT",
  "author": "Logit Solutions AI",
  "optionalDependencies": {
    "kokoro-js": "1.2.1"
  }
}
